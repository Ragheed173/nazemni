generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TaskType {
  LECTURE
  REVIEW
  ASSIGNMENT
  PROJECT
  EXAM_PREP
  PRACTICE
  OTHER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  DEFERRED
}

enum PriorityLevel {
  CRITICAL
  IMPORTANT
  OPTIONAL
}

enum LectureState {
  TAKEN_NOT_STUDIED
  STUDIED
  NEEDS_REVIEW
  MASTERED
}

enum LectureDeliveryMode {
  IN_PERSON
  ONLINE
}

enum WorkStatus {
  NOT_STARTED
  IN_PROGRESS
  READY_TO_SUBMIT
  SUBMITTED
  GRADED
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  SUBMITTED
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ExamType {
  QUIZ
  MIDTERM
  FINAL
}

enum PreparationStatus {
  NOT_STARTED
  IN_PROGRESS
  READY
  COMPLETED
}

enum AssessmentType {
  QUIZ
  ASSIGNMENT
  PROJECT
  MIDTERM
  FINAL
  PARTICIPATION
  OTHER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}

enum ReviewType {
  FIRST_REVIEW
  WEEKLY_REVIEW
  WEAK_TOPIC_REVIEW
  EXAM_REVIEW
}

enum CourseStatus {
  ON_TRACK
  NEEDS_ATTENTION
  AT_RISK
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
  WITHDRAWN
  COMPLETED
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AIMessageRole {
  USER
  ASSISTANT
}

enum CourseCatalogStatus {
  VERIFIED
  PARTIAL
  NOT_VERIFIED
}

enum CourseCatalogSourceType {
  OFFICIAL_CATALOG
  OFFICIAL_DEPARTMENT
  OFFICIAL_SYLLABUS
  UNIVERSITY_DOCUMENT
  SECONDARY
}

model User {
  id                String           @id @default(cuid())
  name              String
  email             String           @unique
  emailVerified     Boolean          @default(false)
  image             String?
  username          String?          @unique
  displayUsername   String?
  role              UserRole         @default(USER)
  status            UserStatus       @default(ACTIVE)
  preferredLanguage String           @default("ar")
  lastLoginAt       DateTime?
  twoFactorEnabled  Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  accounts          Account[]
  sessions          Session[]
  semesters         Semester[]
  customCourses     Course[]         @relation("CustomCourseOwner")
  settings          AppSettings?
  dailyCheckOuts    DailyCheckOut[]
  weeklyReviews     WeeklyReview[]
  inviteCodes       InviteCode[]     @relation("InviteCreator")
  aiConversations   AIConversation[]
  aiUsage           AIUsage[]
  twoFactor         TwoFactor?
  securityAuditLogs SecurityAuditLog[] @relation("SecurityAuditActor")

  @@index([status])
  @@index([role])
}

model TwoFactor {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  secret                  String
  backupCodes             String
  verified                Boolean   @default(false)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@index([lastRequest])
}

model SecurityAuditLog {
  id          String   @id @default(cuid())
  event       String
  actorUserId String?
  targetType  String?
  targetId    String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("SecurityAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([event, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model InviteCode {
  id          String    @id @default(cuid())
  codeHash    String    @unique
  codePreview String
  active      Boolean   @default(true)
  maxUses     Int?
  currentUses Int       @default(0)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  createdById String
  createdBy   User      @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([active, expiresAt])
  @@index([createdById])
}

model Semester {
  id           String           @id @default(cuid())
  name         String
  academicYear String
  term         String
  startsAt     DateTime
  endsAt       DateTime
  isCurrent    Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  userId       String?
  user         User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments  SemesterCourse[]

  @@index([userId, isCurrent])
}

model Course {
  id             String           @id @default(cuid())
  courseCode     String
  nameEn         String
  nameAr         String
  defaultCredits Int
  archived       Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  ownerId        String?
  owner          User?            @relation("CustomCourseOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  enrollments    SemesterCourse[]

  @@unique([ownerId, courseCode])
  @@index([ownerId, archived])
}

model SemesterCourse {
  id                   String                 @id @default(cuid())
  semesterId           String
  courseId             String
  credits              Int
  difficulty           Int
  targetGrade          String                 @default("B+")
  retake               Boolean                @default(false)
  previousGrade        Float?
  replacementEffect    Boolean                @default(false)
  instructor           String?
  section              String?
  enrollmentStatus     EnrollmentStatus       @default(ACTIVE)
  notes                String?
  status               CourseStatus           @default(ON_TRACK)
  lastStudyAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  semester             Semester               @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  catalog              Course                 @relation(fields: [courseId], references: [id], onDelete: Restrict)
  schedule             ScheduleSlot[]
  assessmentComponents AssessmentComponent[]
  lectures             Lecture[]
  tasks                StudyTask[]
  assignments          Assignment[]
  projects             Project[]
  exams                Exam[]
  grades               Grade[]
  weakTopics           WeakTopic[]
  reviews              Review[]
  weeklyCoverage       WeeklyCourseCoverage[]
  catalogEntryId       String?
  catalogEntry         CourseCatalogEntry?    @relation(fields: [catalogEntryId], references: [id], onDelete: SetNull)

  @@unique([semesterId, courseId])
  @@index([semesterId, enrollmentStatus])
  @@index([catalogEntryId])
}

model CourseCatalogEntry {
  id                   String              @id @default(cuid())
  university           String
  universityNormalized String
  program              String
  programNormalized    String
  courseCode           String
  courseCodeNormalized String
  courseName           String
  credits              Int?
  description          String?
  prerequisites        String[]
  topics               String[]
  assessmentInfo       String[]
  officialUrl          String?
  status               CourseCatalogStatus @default(NOT_VERIFIED)
  confidence           Float               @default(0)
  lastVerifiedAt       DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  sources              CourseCatalogSource[]
  semesterCourses      SemesterCourse[]

  @@unique([universityNormalized, programNormalized, courseCodeNormalized], map: "CourseCatalogEntry_identity_key")
  @@index([universityNormalized, programNormalized, courseName], map: "CourseCatalogEntry_name_lookup_idx")
  @@index([lastVerifiedAt])
}

model CourseCatalogSource {
  id          String                  @id @default(cuid())
  entryId     String
  url         String
  sourceType  CourseCatalogSourceType
  title       String
  excerpt     String?
  isOfficial  Boolean                 @default(false)
  retrievedAt DateTime                @default(now())
  entry       CourseCatalogEntry      @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, url])
  @@index([entryId, isOfficial])
}

model ScheduleSlot {
  id               String         @id @default(cuid())
  semesterCourseId String
  dayOfWeek        Int
  startsAt         String
  endsAt           String
  isOnline         Boolean        @default(false)
  location         String?
  course           SemesterCourse @relation(fields: [semesterCourseId], references: [id], onDelete: Cascade)

  @@index([dayOfWeek, startsAt])
}

model AssessmentComponent {
  id               String         @id @default(cuid())
  semesterCourseId String
  type             AssessmentType
  name             String
  weight           Float?
  enabled          Boolean        @default(true)
  order            Int            @default(0)
  enrollment       SemesterCourse @relation(fields: [semesterCourseId], references: [id], onDelete: Cascade)

  @@unique([semesterCourseId, order])
  @@index([semesterCourseId, enabled])
}

model Lecture {
  id                 String         @id @default(cuid())
  courseId           String
  number             Int
  title              String
  lectureDate        DateTime
  takenAtUniversity  Boolean        @default(true)
  durationMinutes    Int            @default(60)
  deliveryMode       LectureDeliveryMode @default(IN_PERSON)
  attended           Boolean        @default(false)
  state              LectureState   @default(TAKEN_NOT_STUDIED)
  understandingScore Int?
  notes              String?
  needsReview        Boolean        @default(false)
  studiedAt          DateTime?
  lastReviewedAt     DateTime?
  masteredAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  course             SemesterCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tasks              StudyTask[]
  reviews            Review[]

  @@unique([courseId, number])
  @@index([courseId, state])
}

model StudyTask {
  id              String         @id @default(cuid())
  courseId        String
  lectureId       String?
  title           String
  description     String?
  type            TaskType
  priority        PriorityLevel  @default(IMPORTANT)
  priorityScore   Int            @default(0)
  priorityReason  String?
  status          TaskStatus     @default(TODO)
  dueAt           DateTime?
  estimatedEffort Int?
  source          String?
  notes           String?
  deferredCount   Int            @default(0)
  createdAt       DateTime       @default(now())
  completedAt     DateTime?
  updatedAt       DateTime       @updatedAt
  course          SemesterCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lecture         Lecture?       @relation(fields: [lectureId], references: [id], onDelete: SetNull)

  @@index([status, dueAt])
  @@index([courseId, priorityScore])
}

model Assignment {
  id               String         @id @default(cuid())
  courseId         String
  title            String
  description      String?
  releaseDate      DateTime?
  officialDeadline DateTime
  internalDeadline DateTime?
  weight           Float?
  status           WorkStatus     @default(NOT_STARTED)
  progress         Int            @default(0)
  priority         PriorityLevel  @default(IMPORTANT)
  notes            String?
  submittedAt      DateTime?
  grade            Float?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  course           SemesterCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([status, officialDeadline])
  @@index([courseId])
}

model Project {
  id               String             @id @default(cuid())
  courseId         String
  name             String
  description      String?
  startDate        DateTime?
  officialDeadline DateTime
  internalDeadline DateTime?
  weight           Float?
  status           ProjectStatus      @default(NOT_STARTED)
  progress         Int                @default(0)
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  course           SemesterCourse     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  milestones       ProjectMilestone[]

  @@index([status, officialDeadline])
  @@index([courseId])
}

model ProjectMilestone {
  id          String          @id @default(cuid())
  projectId   String
  title       String
  status      MilestoneStatus @default(NOT_STARTED)
  dueAt       DateTime?
  notes       String?
  order       Int
  completedAt DateTime?
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, order])
}

model Exam {
  id                 String            @id @default(cuid())
  courseId           String
  type               ExamType
  title              String
  date               DateTime
  coveredLectures    Int[]
  coveredTopics      String[]
  notes              String?
  preparationStatus  PreparationStatus @default(NOT_STARTED)
  preparationStartAt DateTime?
  confidenceLevel    Int?
  weight             Float?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  course             SemesterCourse    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([date, preparationStatus])
  @@index([courseId])
}

model Grade {
  id             String         @id @default(cuid())
  courseId       String
  assessmentType AssessmentType
  title          String
  score          Float
  maximumScore   Float
  weight         Float?
  date           DateTime
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  course         SemesterCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, date])
}

model WeakTopic {
  id             String         @id @default(cuid())
  courseId       String
  topic          String
  description    String?
  severity       Severity       @default(MEDIUM)
  lastReviewedAt DateTime?
  reviewCount    Int            @default(0)
  resolved       Boolean        @default(false)
  resolvedAt     DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  course         SemesterCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  reviews        Review[]

  @@index([courseId, resolved, severity])
}

model Review {
  id          String         @id @default(cuid())
  courseId    String
  lectureId   String?
  weakTopicId String?
  type        ReviewType
  scheduledAt DateTime
  completedAt DateTime?
  notes       String?
  createdAt   DateTime       @default(now())
  course      SemesterCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lecture     Lecture?       @relation(fields: [lectureId], references: [id], onDelete: SetNull)
  weakTopic   WeakTopic?     @relation(fields: [weakTopicId], references: [id], onDelete: SetNull)

  @@index([scheduledAt, completedAt])
  @@index([courseId])
}

model DailyCheckOut {
  id                  String   @id @default(cuid())
  date                DateTime
  stoppedAt           String?
  misunderstoodTopics String[]
  notes               String?
  selfRating          Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  userId              String?
  user                User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model WeeklyReview {
  id                   String                 @id @default(cuid())
  weekStart            DateTime
  weekEnd              DateTime
  score                Int
  completionPercentage Int
  backlogState         String
  keyRisks             String[]
  nextWeekPriorities   String[]
  notes                String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  userId               String?
  user                 User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  coverage             WeeklyCourseCoverage[]

  @@unique([userId, weekStart])
  @@index([userId, weekStart])
}

model WeeklyCourseCoverage {
  id             String         @id @default(cuid())
  weeklyReviewId String
  courseId       String
  sessions       Int            @default(0)
  tasksCompleted Int            @default(0)
  covered        Boolean        @default(false)
  weeklyReview   WeeklyReview   @relation(fields: [weeklyReviewId], references: [id], onDelete: Cascade)
  course         SemesterCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([weeklyReviewId, courseId])
}

model AppSettings {
  id               String   @id @default(cuid())
  userId           String?  @unique
  language         String   @default("ar")
  timezone         String   @default("Asia/Hebron")
  weeklyReviewDay  Int      @default(6)
  defaultTarget    String   @default("B+")
  retakeBonus      Int      @default(8)
  firstReviewHours Int      @default(24)
  focusModeManual  Boolean?
  focusModeReason  String?
  priorityWeights  Json
  updatedAt        DateTime @updatedAt
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AIConversation {
  id        String      @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AIMessage[]

  @@index([userId, updatedAt])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           AIMessageRole
  content        String
  toolMetadata   Json?
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AIUsage {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime
  requestCount Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  errorCount   Int      @default(0)
  provider     String
  model        String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, provider, model])
  @@index([date])
}
