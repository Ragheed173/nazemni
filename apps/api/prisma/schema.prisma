generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskType {
  LECTURE
  REVIEW
  ASSIGNMENT
  PROJECT
  EXAM_PREP
  PRACTICE
  OTHER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  DEFERRED
}

enum PriorityLevel {
  CRITICAL
  IMPORTANT
  OPTIONAL
}

enum LectureState {
  TAKEN_NOT_STUDIED
  STUDIED
  NEEDS_REVIEW
  MASTERED
}

enum WorkStatus {
  NOT_STARTED
  IN_PROGRESS
  READY_TO_SUBMIT
  SUBMITTED
  GRADED
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  SUBMITTED
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ExamType {
  QUIZ
  MIDTERM
  FINAL
}

enum PreparationStatus {
  NOT_STARTED
  IN_PROGRESS
  READY
  COMPLETED
}

enum AssessmentType {
  QUIZ
  ASSIGNMENT
  PROJECT
  MIDTERM
  FINAL
  PARTICIPATION
  OTHER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}

enum ReviewType {
  FIRST_REVIEW
  WEEKLY_REVIEW
  WEAK_TOPIC_REVIEW
  EXAM_REVIEW
}

enum CourseStatus {
  ON_TRACK
  NEEDS_ATTENTION
  AT_RISK
}

model Semester {
  id          String   @id @default(cuid())
  name        String
  startsAt    DateTime
  endsAt      DateTime
  creditHours Int
  targetGrade String   @default("B+")
  isCurrent   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  courses     Course[]

  @@index([isCurrent])
}

model Course {
  id                String       @id @default(cuid())
  semesterId        String
  code              String
  nameEn            String
  nameAr            String
  difficulty        Int
  credits           Int
  retake            Boolean      @default(false)
  previousGrade     Float?
  replacementEffect Boolean      @default(false)
  targetGrade       String       @default("B+")
  specialNote       String?
  status            CourseStatus @default(ON_TRACK)
  lastStudyAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  semester          Semester     @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  schedule           UniversitySchedule[]
  lectures           Lecture[]
  tasks              StudyTask[]
  assignments        Assignment[]
  projects           Project[]
  exams              Exam[]
  grades             Grade[]
  weakTopics         WeakTopic[]
  reviews            Review[]
  weeklyCoverage     WeeklyCourseCoverage[]

  @@unique([semesterId, code])
  @@index([semesterId, status])
}

model UniversitySchedule {
  id        String   @id @default(cuid())
  courseId String
  dayOfWeek Int
  startsAt String
  endsAt   String
  isOnline Boolean  @default(false)
  location String?
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([dayOfWeek, startsAt])
}

model Lecture {
  id                 String       @id @default(cuid())
  courseId           String
  number             Int
  title              String
  lectureDate        DateTime
  takenAtUniversity  Boolean      @default(true)
  state              LectureState @default(TAKEN_NOT_STUDIED)
  understandingScore Int?
  notes              String?
  needsReview        Boolean      @default(false)
  studiedAt          DateTime?
  lastReviewedAt     DateTime?
  masteredAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  course             Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tasks              StudyTask[]
  reviews            Review[]

  @@unique([courseId, number])
  @@index([courseId, state])
}

model StudyTask {
  id              String        @id @default(cuid())
  courseId        String
  lectureId       String?
  title           String
  description     String?
  type            TaskType
  priority        PriorityLevel @default(IMPORTANT)
  priorityScore   Int           @default(0)
  priorityReason  String?
  status          TaskStatus    @default(TODO)
  dueAt           DateTime?
  estimatedEffort Int?
  source          String?
  notes           String?
  deferredCount   Int           @default(0)
  createdAt       DateTime      @default(now())
  completedAt     DateTime?
  updatedAt       DateTime      @updatedAt
  course          Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lecture         Lecture?      @relation(fields: [lectureId], references: [id], onDelete: SetNull)

  @@index([status, dueAt])
  @@index([courseId, priorityScore])
}

model Assignment {
  id                 String     @id @default(cuid())
  courseId           String
  title              String
  description        String?
  releaseDate        DateTime?
  officialDeadline   DateTime
  internalDeadline   DateTime?
  weight             Float?
  status             WorkStatus @default(NOT_STARTED)
  progress           Int        @default(0)
  priority           PriorityLevel @default(IMPORTANT)
  notes              String?
  submittedAt        DateTime?
  grade              Float?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  course             Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([status, officialDeadline])
  @@index([courseId])
}

model Project {
  id               String        @id @default(cuid())
  courseId         String
  name             String
  description      String?
  startDate        DateTime?
  officialDeadline DateTime
  internalDeadline DateTime?
  weight           Float?
  status           ProjectStatus @default(NOT_STARTED)
  progress         Int           @default(0)
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  course           Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  milestones       ProjectMilestone[]

  @@index([status, officialDeadline])
  @@index([courseId])
}

model ProjectMilestone {
  id          String          @id @default(cuid())
  projectId   String
  title       String
  status      MilestoneStatus @default(NOT_STARTED)
  dueAt       DateTime?
  notes       String?
  order       Int
  completedAt DateTime?
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, order])
}

model Exam {
  id                  String            @id @default(cuid())
  courseId            String
  type                ExamType
  title               String
  date                DateTime
  coveredLectures     Int[]
  coveredTopics       String[]
  notes               String?
  preparationStatus   PreparationStatus @default(NOT_STARTED)
  preparationStartAt  DateTime?
  confidenceLevel     Int?
  weight              Float?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  course              Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([date, preparationStatus])
  @@index([courseId])
}

model Grade {
  id             String         @id @default(cuid())
  courseId       String
  assessmentType AssessmentType
  title          String
  score          Float
  maximumScore   Float
  weight         Float?
  date           DateTime
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  course         Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, date])
}

model WeakTopic {
  id             String   @id @default(cuid())
  courseId       String
  topic          String
  description    String?
  severity       Severity @default(MEDIUM)
  lastReviewedAt DateTime?
  reviewCount    Int      @default(0)
  resolved       Boolean  @default(false)
  resolvedAt     DateTime?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  reviews         Review[]

  @@index([courseId, resolved, severity])
}

model Review {
  id          String     @id @default(cuid())
  courseId    String
  lectureId   String?
  weakTopicId String?
  type        ReviewType
  scheduledAt DateTime
  completedAt DateTime?
  notes       String?
  createdAt   DateTime   @default(now())
  course      Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lecture     Lecture?   @relation(fields: [lectureId], references: [id], onDelete: SetNull)
  weakTopic   WeakTopic? @relation(fields: [weakTopicId], references: [id], onDelete: SetNull)

  @@index([scheduledAt, completedAt])
  @@index([courseId])
}

model DailyCheckOut {
  id                  String   @id @default(cuid())
  date                DateTime @unique
  stoppedAt           String?
  misunderstoodTopics String[]
  notes               String?
  selfRating          Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model WeeklyReview {
  id                   String   @id @default(cuid())
  weekStart            DateTime @unique
  weekEnd              DateTime
  score                Int
  completionPercentage Int
  backlogState         String
  keyRisks             String[]
  nextWeekPriorities   String[]
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  coverage             WeeklyCourseCoverage[]
}

model WeeklyCourseCoverage {
  id             String       @id @default(cuid())
  weeklyReviewId String
  courseId       String
  sessions       Int          @default(0)
  tasksCompleted Int          @default(0)
  covered        Boolean      @default(false)
  weeklyReview   WeeklyReview @relation(fields: [weeklyReviewId], references: [id], onDelete: Cascade)
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([weeklyReviewId, courseId])
}

model AppSettings {
  id                  String   @id @default("settings")
  language            String   @default("ar")
  weeklyReviewDay     Int      @default(6)
  defaultTarget       String   @default("B+")
  retakeBonus         Int      @default(8)
  firstReviewHours    Int      @default(24)
  focusModeManual     Boolean?
  focusModeReason     String?
  priorityWeights     Json
  updatedAt           DateTime @updatedAt
}
