DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nazemni?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/nazemni?schema=public"
API_PORT=4000
WEB_ORIGIN="http://localhost:5173"
# Optional comma-separated exact origins for intentional staging deployments. Never use wildcards.
AUTH_TRUSTED_ORIGINS=""
VITE_API_URL="http://localhost:4000/api"
AUTH_SESSION_SECRET="replace-with-at-least-32-random-characters"
AUTH_SESSION_TTL_DAYS=30
REGISTRATION_MODE="INVITE_ONLY"
OWNER_USERNAME="ragheed"
OWNER_EMAIL="ragheed@nazemni.online"
# Required only for the one-time owner migration; keep it out of Git.
AUTH_PASSWORD_HASH="$2b$12$existing-owner-bcrypt-hash"

# AI Assistant (provider calls are backend-only). Leave disabled until a real key is configured.
AI_ENABLED=false
AI_PROVIDER=openai-compatible
AI_MODEL=openai/gpt-oss-20b
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MAX_OUTPUT_TOKENS=1200
AI_REQUESTS_PER_MINUTE=5
AI_REQUESTS_PER_DAY=20
AI_MAX_MESSAGE_LENGTH=4000
AI_MAX_TOOL_ITERATIONS=4
AI_TIMEOUT_MS=30000
AI_HISTORY_MAX_MESSAGES=8
AI_HISTORY_MAX_TOKENS=1200
AI_INPUT_TOKEN_BUDGET_PER_MINUTE=7000
AI_MAX_CONCURRENT_PER_USER=1

# Course Intelligence (server-side search and extraction only). Disabled by default.
COURSE_INTELLIGENCE_ENABLED=false
# Supported values: brave, tavily
COURSE_INTELLIGENCE_SEARCH_PROVIDER=brave
COURSE_INTELLIGENCE_SEARCH_API_KEY=
# Optional. Defaults to the selected provider's official search endpoint.
COURSE_INTELLIGENCE_SEARCH_BASE_URL=
COURSE_INTELLIGENCE_AI_MODEL=openai/gpt-oss-20b
COURSE_INTELLIGENCE_AI_BASE_URL=https://api.groq.com/openai/v1
COURSE_INTELLIGENCE_CACHE_DAYS=30
COURSE_INTELLIGENCE_MAX_SEARCH_RESULTS=5
COURSE_INTELLIGENCE_MAX_FETCHED_PAGES=3
COURSE_INTELLIGENCE_MAX_SOURCE_BYTES=512000
COURSE_INTELLIGENCE_MAX_EXTRACTED_CHARS=12000
COURSE_INTELLIGENCE_AI_CONTEXT_CHARS=9000
COURSE_INTELLIGENCE_AI_MAX_OUTPUT_TOKENS=1200
COURSE_INTELLIGENCE_TIMEOUT_MS=10000
COURSE_INTELLIGENCE_REQUESTS_PER_MINUTE=3
