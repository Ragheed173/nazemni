DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nazemni?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/nazemni?schema=public"
API_PORT=4000
WEB_ORIGIN="http://localhost:5173"
# Optional comma-separated exact origins for intentional staging deployments. Never use wildcards.
AUTH_TRUSTED_ORIGINS=""
VITE_API_URL="http://localhost:4000/api"
AUTH_SESSION_SECRET="replace-with-at-least-32-random-characters"
AUTH_SESSION_TTL_DAYS=30
REGISTRATION_MODE="INVITE_ONLY"
OWNER_USERNAME="ragheed"
OWNER_EMAIL="ragheed@nazemni.online"
# Required only for the one-time owner migration; keep it out of Git.
AUTH_PASSWORD_HASH="$2b$12$existing-owner-bcrypt-hash"

# AI Assistant (provider calls are backend-only). Leave disabled until a real key is configured.
AI_ENABLED=false
AI_PROVIDER=openai-compatible
AI_MODEL=openai/gpt-oss-20b
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MAX_OUTPUT_TOKENS=1200
AI_REQUESTS_PER_MINUTE=5
AI_REQUESTS_PER_DAY=20
AI_MAX_MESSAGE_LENGTH=4000
AI_MAX_TOOL_ITERATIONS=4
AI_TIMEOUT_MS=30000
AI_HISTORY_MAX_MESSAGES=8
AI_HISTORY_MAX_TOKENS=1200
AI_INPUT_TOKEN_BUDGET_PER_MINUTE=7000
AI_MAX_CONCURRENT_PER_USER=1
